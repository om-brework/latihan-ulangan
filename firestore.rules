rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tiap orang tua hanya bisa membaca dan menulis data miliknya sendiri.
    match /users/{uid}/children/{childId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'icon', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && request.resource.data.icon is string && request.resource.data.icon.size() <= 8;

      match /attempts/{attemptId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.nilai is int
          && request.resource.data.at is int
          && request.resource.data.wrong is list && request.resource.data.wrong.size() <= 60;
      }
    }
  }
}
